# Journey Tutor — example environment variables
# Copy to .env and fill in values. Never commit real secrets.

# Required for live Gemini generation. If empty, FakeLessonGenerator is used.
# When set, failures are returned as HTTP errors — there is no silent fake fallback.
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
WORDS_PER_MINUTE=130
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
